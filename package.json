{
  "name": "gp-circle",
  "private": true,
  "version": "0.2.5",
  "description": "股票小分队：A股协同观察、持仓与跟投交流",
  "homepage": "https://stockteam.uasier.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uasier/stockteam.git"
  },
  "keywords": [
    "股票小分队",
    "A股",
    "自选",
    "持仓",
    "tauri"
  ],
  "license": "MIT",
